# ---------------------------------------------------------------------------
# First run: MOCK_LLM=1 keeps everything deterministic and offline.
# Real model: MOCK_LLM=0 and put the key in .env only (never commit it).
# ---------------------------------------------------------------------------
QWEN_API_KEY=
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen3.8-flash
QWEN_FALLBACK_MODEL=
MOCK_LLM=1

# --- model call policy -----------------------------------------------------
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_JSON_MODE=0
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30
LLM_CACHE_ENABLED=1
LLM_CACHE_TTL_SECONDS=600
REDIS_URL=

# --- ReAct budget (hard limits, enforced in code) ---------------------------
REACT_MAX_STEPS=6
REACT_MAX_TOOL_CALLS=6
REACT_MAX_MODEL_CALLS=8
TASK_TIMEOUT_SECONDS=120
TASK_MAX_TOKENS=24000

# --- retry policy -----------------------------------------------------------
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.4
RETRY_MAX_DELAY_SECONDS=8.0
RETRY_JITTER_RATIO=0.25

# --- circuits ---------------------------------------------------------------
CIRCUIT_FAILURE_THRESHOLD=4
CIRCUIT_COOLDOWN_SECONDS=20
CIRCUIT_HALF_OPEN_MAX_CALLS=1
CIRCUIT_HALF_OPEN_SUCCESS_THRESHOLD=1

# --- idempotency ------------------------------------------------------------
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LEASE_SECONDS=30

# --- persistence ------------------------------------------------------------
TASKPILOT_DB_PATH=data/taskpilot.sqlite3
TASKPILOT_CHECKPOINT_PATH=data/checkpoints.sqlite3
TASKPILOT_UPLOAD_DIR=data/uploads
TASKPILOT_OUTPUT_DIR=outputs
RECOVER_ON_STARTUP=1
STALE_TASK_SECONDS=90

# --- context / memory -------------------------------------------------------
CONTEXT_MAX_CHARS=8000
MEMORY_TTL_DAYS=14
MEMORY_MAX_ITEMS=200

# --- API / safety -----------------------------------------------------------
TASKPILOT_API_TOKEN=
RATE_LIMIT_PER_MINUTE=60
TOOL_TIMEOUT_SECONDS=20
TOOL_CONCURRENCY=4
SHUTDOWN_GRACE_SECONDS=10
TASKPILOT_LOG_LEVEL=INFO
TASKPILOT_LOG_JSON=1

# --- tools ------------------------------------------------------------------
TAVILY_API_KEY=

# --- test seams (never enable in production) --------------------------------
TASKPILOT_FAULT_INJECTION=0
# TASKPILOT_CRASH_AT=after_tool_success